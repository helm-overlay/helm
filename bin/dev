#!/usr/bin/env bash
# bin/dev — Helm dev-loop helper.
#
# Usage:
#   bin/dev app       rebuild full Helm.app Debug
#   bin/dev ship      rebuild Helm.app Release, install to /Applications
#   bin/dev test      generate project + run HelmCore tests
#   bin/dev check     generate project + run tests + Debug app build
#   bin/dev restart   kill any running Helm and relaunch the Debug build
#   bin/dev run       rebuild Debug app, then restart

set -e

here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"

ensure_project() {
  if command -v xcodegen >/dev/null 2>&1; then
    xcodegen generate >/dev/null
  elif [ ! -d Helm.xcodeproj ]; then
    echo "Helm.xcodeproj missing and xcodegen not found" >&2
    exit 1
  fi
}

install_cli() {
  local config=${1:-Debug}
  xcodebuild -project Helm.xcodeproj -target HelmCLI \
             -configuration "$config" -quiet \
             ARCHS=arm64 ONLY_ACTIVE_ARCH=YES
  mkdir -p "$HOME/.local/bin"
  ln -sf "$here/build/$config/helm" "$HOME/.local/bin/helm"
  echo "helm CLI linked: $HOME/.local/bin/helm -> $here/build/$config/helm"
}

restart_app() {
  local app="$here/build/Debug/Helm.app"
  [ -d "$app" ] || { echo "no Debug build at $app — run 'bin/dev app' first" >&2; exit 1; }
  # Kill every running Helm (Debug build, /Applications copy, stale instances) so the
  # ⌥Space hotkey isn't held by an old process when the new one launches.
  pkill -x Helm 2>/dev/null && sleep 0.5 || true
  open -n "$app"
  echo "restarted: $app"
}

case "${1:-}" in
  app)
    ensure_project
    xcodebuild -project Helm.xcodeproj -target Helm \
               -configuration Debug -quiet \
               ARCHS=arm64 ONLY_ACTIVE_ARCH=YES
    install_cli Debug
    echo "Helm.app at: $here/build/Debug/Helm.app"
    echo "Launch with: open ./build/Debug/Helm.app"
    ;;
  ship)
    ensure_project
    xcodebuild -project Helm.xcodeproj -target Helm \
               -configuration Release -quiet
    install_cli Release
    rm -rf /Applications/Helm.app
    cp -R ./build/Release/Helm.app /Applications/
    echo "shipped: /Applications/Helm.app"
    ;;
  test)
    ensure_project
    xcodebuild -project Helm.xcodeproj -scheme HelmCore \
               -destination 'platform=macOS' test
    ;;
  check)
    ensure_project
    xcodebuild -project Helm.xcodeproj -scheme HelmCore \
               -destination 'platform=macOS' test
    xcodebuild -project Helm.xcodeproj -scheme Helm \
               -configuration Debug build
    install_cli Debug
    ;;
  restart)
    restart_app
    ;;
  run)
    ensure_project
    xcodebuild -project Helm.xcodeproj -target Helm \
               -configuration Debug -quiet \
               ARCHS=arm64 ONLY_ACTIVE_ARCH=YES
    install_cli Debug
    restart_app
    ;;
  *)
    echo "usage: bin/dev {app|ship|test|check|restart|run}" >&2
    exit 2
    ;;
esac
